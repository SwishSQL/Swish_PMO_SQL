# SQL Server connection. Either one URL:
#   DATABASE_URL=sqlserver://pmo_app:password@db-host:1433/swish_pmo
# or the separate settings below (a password with special characters is easier here than in a URL).
DATABASE_URL=
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=swish_pmo
# TLS to the database: MSSQL_ENCRYPT=true turns it on. The server certificate is trusted unless MSSQL_TRUST_CERT=false.
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
# First start on a new server: the database is created by the server itself if it does not exist (the login needs the
# dbcreator role), so nobody has to prepare it. To let it create the LOGIN as well, give an administrator login that is
# used for that first start only (then remove these two lines). MSSQL_AUTO_CREATE=false turns the creation off.
MSSQL_ADMIN_USER=
MSSQL_ADMIN_PASSWORD=
MSSQL_AUTO_CREATE=
# The server creates whatever of the schema is missing every time it starts (sql/schema.sql, safe to repeat).
# Set SKIP_SCHEMA=1 when a DBA runs sql/schema.sql by hand instead.
SKIP_SCHEMA=

PORT=8090
# The public address of the app, for the links in emails and in the owner's setup link.
APP_URL=

# The protected owner accounts (several: separate the addresses and the names with commas): always active, always PMO admin, and the only
# account that can create accounts and change permissions. It is created
# without a password; the first sign-in with this email sets one. No password
# ever lives in code or in an environment variable.
OWNER_EMAIL=m.roushdy@swishhh.net,fawzan@swishhh.net
OWNER_NAME=Mamdouh,Fawzan

# The project assistant (optional). Without a key the "Create with the assistant" button is not shown
# and everything else works. The key is the organisation's Anthropic API key (an API key from
# console.anthropic.com, starting sk-ant-api03-). AI_MODEL changes the model without touching code
# (default claude-haiku-5-5, the fastest).
ANTHROPIC_API_KEY=
AI_MODEL=

# Mail, for the password a new person is emailed the first time they sign in, and for the notification
# emails (optional: without it the PMO sends setup links by hand). Use a mailbox made for the system and
# never put a real password in a file that is committed. MAIL_FROM defaults to SMTP_USER. A copy list (CC)
# is deliberately not supported: a copy of an emailed password would reach everyone on it.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
