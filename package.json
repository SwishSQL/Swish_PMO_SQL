{
  "name": "swish-pmo-sql",
  "version": "0.1.0",
  "private": true,
  "description": "SWiSH PMO (SQL Server edition) - portfolio and project management for the Project Management Office",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "import": "tsx server/import-tracker.ts",
    "invite-link": "tsx server/invite-link.ts",
    "start": "node dist/server/index.js",
    "migrate:from-postgres": "tsx server/migrate-from-postgres.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "comment": "Build-time packages live in dependencies on purpose: the deploy runs `npm ci` with NODE_ENV=production, which skips devDependencies, and `npm run build` needs vite, typescript and react.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "motion": "^12.43.0",
    "mssql": "^11.0.2",
    "nodemailer": "^10.1.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
